# ─── Server ───────────────────────────────────────────────
PORT=8080
ENVIRONMENT=development
APP_BASE_URL=http://localhost:8080

# ─── Database ─────────────────────────────────────────────
DATABASE_URL=postgres://dev:dev@localhost:5432/schoolplatform?sslmode=disable

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-256-bit-secret
JWT_REFRESH_SECRET=change-me-to-a-separate-random-256-bit-secret

# ─── CSRF ─────────────────────────────────────────────────
CSRF_SECRET=change-me-to-a-random-csrf-secret

# ─── Cloudinary ───────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_PRESET=school_signed_preset

# ─── Email (Resend) ───────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key

# ─── Chromium ─────────────────────────────────────────────
CHROMIUM_PATH=/usr/bin/google-chrome

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW=15m

# ─── Sentry ───────────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
